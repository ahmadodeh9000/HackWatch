  {
   "type": "events",
   "id": "589335",
   "attributes": {
    "id": 589335,
    "title": "IEEE Huntsville TEMS Chapter & Professional Activities Committee",
    "description": "<table style=\"background-color: #f4f6f9; padding: 20px 0;\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td align=\"center\"><!-- Main Email Container -->\r\n<table style=\"background-color: #ffffff; border: 1px solid #e0e0e0; border-collapse: collapse;\" border=\"0\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\"><!-- Header Banner -->\r\n<tbody>\r\n<tr>\r\n<td style=\"padding: 25px 20px; background-color: #002855; color: #ffffff;\" align=\"center\" bgcolor=\"#002855\">\r\n<table border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"font-size: 13px; font-weight: bold; letter-spacing: 1px; color: #00b0ff; text-transform: uppercase;\" align=\"left\">IEEE Huntsville Section &bull; TEMS &amp; PAC</td>\r\n</tr>\r\n<tr>\r\n<td style=\"font-size: 22px; font-weight: bold; color: #ffffff; padding-top: 8px; line-height: 28px;\" align=\"left\">Joint Professional Development Workshop</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n</td>\r\n</tr>\r\n<!-- Flyer Image Placeholder / Embed -->\r\n<tr>\r\n<td style=\"padding: 10px; background-color: #1a2530;\" align=\"center\" bgcolor=\"#1a2530\">\r\n<p>&nbsp;</p>\r\n<p><img src=\"https://enotice.vtools.ieee.org/vtools_ui/media/display/abbc0a3c-a05d-4d26-8821-5479146f1441\" width=\"500\"></p>\r\n</td>\r\n</tr>\r\n<!-- Main Body Content -->\r\n<tr>\r\n<td style=\"padding: 30px 25px; color: #333333; font-size: 15px; line-height: 22px;\">\r\n<p style=\"margin-top: 0; margin-bottom: 15px; font-weight: bold; color: #002855; font-size: 18px;\">Leveraging Your Leadership Style to Motivate Your Team</p>\r\n<p style=\"margin-top: 0; margin-bottom: 15px;\">Join the <strong>IEEE Huntsville Section TEMS Chapter</strong> and <strong>Professional Activities Committee (PAC)</strong> for a special joint professional development session co-hosted with <strong>SHPE Huntsville</strong> and <strong>NSBE North Alabama Professionals</strong>.</p>\r\n<p style=\"margin-top: 0; margin-bottom: 20px;\">We are thrilled to welcome guest speaker <strong>Antonio (Tony) Delgado, P.E.</strong> (EMB Business Unit Lead at Merrick &amp; Company), who is flying in out-of-state for this event. Learn practical strategies to inspire your team, strengthen workplace collaboration, and expand your professional network!</p>\r\n<!-- Event Logistics Box -->\r\n<table style=\"background-color: #f8f9fa; border-left: 4px solid #006699; margin-bottom: 25px;\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"padding: 15px 20px;\">\r\n<table style=\"height: 110px;\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"height: 22px;\">\r\n<td style=\"padding-bottom: 8px; font-size: 14px; color: rgb(51, 51, 51); height: 22px;\"><strong>Date:</strong> Thursday, November 12th</td>\r\n</tr>\r\n<tr style=\"height: 22px;\">\r\n<td style=\"padding-bottom: 8px; font-size: 14px; color: rgb(51, 51, 51); height: 22px;\"><strong>Time:</strong> 6:00 PM (Workshop)</td>\r\n</tr>\r\n<tr style=\"height: 22px;\">\r\n<td style=\"padding-bottom: 8px; font-size: 14px; color: rgb(51, 51, 51); height: 22px;\"><strong>Location:</strong> 360C Quality Cir NW, Suite 310, Huntsville, AL 35806</td>\r\n</tr>\r\n<tr style=\"height: 22px;\">\r\n<td style=\"padding-bottom: 8px; font-size: 14px; color: rgb(51, 51, 51); height: 22px;\"><strong>Cost:</strong> FREE (Members &amp; Friends Welcome!)</td>\r\n</tr>\r\n<tr style=\"height: 22px;\">\r\n<td style=\"font-size: 14px; color: rgb(51, 51, 51); height: 22px;\"><strong>Food:</strong> Provided</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<!-- Call to Action Button -->\r\n<table style=\"margin-bottom: 25px;\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td align=\"center\">\r\n<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td style=\"border-radius: 4px; background-color: #006699;\" align=\"center\" bgcolor=\"#006699\"><a style=\"font-size: 16px; font-family: Arial, sans-serif; color: #ffffff; text-decoration: none; border-radius: 4px; padding: 12px 25px; border: 1px solid #006699; display: inline-block; font-weight: bold;\" href=\"https://www.zeffy.com/en-US/ticketing/annual-gala-8976\" target=\"_blank\" rel=\"noopener\"> RSVP </a></td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<!-- Host & Sponsor Recognition -->\r\n<table style=\"border-top: 1px solid #eeeeee; padding-top: 20px; font-size: 13px; color: #666666; line-height: 18px;\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td>\r\n<p style=\"margin: 0 0 8px 0;\"><strong>Hosted in Collaboration By:</strong></p>\r\n<p style=\"margin: 0 0 15px 0;\">SHPE Huntsville Professional Chapter, NSBE North Alabama Professionals, and IEEE Huntsville Section (TEMS &amp; PAC).</p>\r\n<p style=\"margin: 0 0 8px 0;\"><strong>Sponsored By:</strong></p>\r\n<p style=\"margin: 0;\">Merrick &amp; Company | MTSI</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n</td>\r\n</tr>\r\n<!-- Footer -->\r\n<tr>\r\n<td style=\"padding: 20px; background-color: #002855; color: #cccccc; font-size: 12px; line-height: 16px;\" align=\"center\" bgcolor=\"#002855\">\r\n<p style=\"margin: 0 0 5px 0; font-weight: bold; color: #ffffff;\">IEEE Huntsville Section</p>\r\n<p style=\"margin: 0 0 10px 0;\">Technology &amp; Engineering Management Society (TEMS) &amp; Professional Activities Committee (PAC)</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>",
