    "agenda": "<div class=\"container\">\r\n<div id=\"model-response-message-contentr_188c6aeac6b66263\" class=\"markdown markdown-main-panel md-content enable-luminous-fast-follows enable-updated-hr-color\" dir=\"ltr\" style=\"--animation-duration: 400ms; --fade-animation-function: ease-out;\" aria-busy=\"false\" aria-live=\"off\">\r\n<ul data-path-to-node=\"7\">\r\n<li>\r\n<ul>\r\n<li>\r\n<p data-path-to-node=\"9,0,0\"><strong data-path-to-node=\"9,0,0\" data-index-in-node=\"0\">09:00 AM &ndash; 09:30 AM:</strong> Registration &amp; Welcoming Reception</p>\r\n</li>\r\n<li>\r\n<p data-path-to-node=\"9,1,0\"><strong data-path-to-node=\"9,1,0\" data-index-in-node=\"0\">09:30 AM &ndash; 10:30 AM:</strong> Official Opening Ceremony <em data-path-to-node=\"9,1,0\" data-index-in-node=\"47\">(Wesam Bushnaq Hall)</em></p>\r\n<ul data-path-to-node=\"9,1,1\">\r\n<li>\r\n<p data-path-to-node=\"9,1,1,0,0\">Opening Remarks</p>\r\n</li>\r\n<li>\r\n<p data-path-to-node=\"9,1,1,1,0\">Speech by Faculty Dean</p>\r\n</li>\r\n<li>\r\n<p data-path-to-node=\"9,1,1,2,0\">Speech by IEEE Student Branch Advisor &amp; Chair</p>\r\n</li>\r\n</ul>\r\n</li>\r\n<li>\r\n<p data-path-to-node=\"9,2,0\"><strong data-path-to-node=\"9,2,0\" data-index-in-node=\"0\">10:30 AM &ndash; 02:00 PM:</strong> IEEE Societies Exhibition &amp; Outdoor Booths</p>\r\n<ul data-path-to-node=\"9,2,1\">\r\n<li>\r\n<p data-path-to-node=\"9,2,1,0,0\">Interactive booths for all IEEE Student Branch Societies</p>\r\n</li>\r\n<li>\r\n<p data-path-to-node=\"9,2,1,1,0\">Networking, games, and direct engagement with members</p>\r\n</li>\r\n</ul>\r\n</li>\r\n<li>\r\n<p data-path-to-node=\"9,3,0\"><strong data-path-to-node=\"9,3,0\" data-index-in-node=\"0\">02:00 PM &ndash; 03:00 PM:</strong> Award Ceremony, Giveaways &amp; Closing Remarks <em data-path-to-node=\"9,3,0\" data-index-in-node=\"65\">(Wesam Bushnaq Hall)</em></p>\r\n<ul data-path-to-node=\"9,3,1\">\r\n<li>\r\n<p data-path-to-node=\"9,3,1,0,0\">Distribution of gifts &amp; prizes</p>\r\n</li>\r\n<li>\r\n<p data-path-to-node=\"9,3,1,1,0\">Recognition of outstanding contributors and volunteers</p>\r\n</li>\r\n<li>\r\n<p data-path-to-node=\"9,3,1,2,0\">Group Photo &amp; Wrap-up</p>\r\n</li>\r\n</ul>\r\n</li>\r\n</ul>\r\n</li>\r\n<li>&nbsp;</li>\r\n</ul>\r\n</div>\r\n<!----></div>",
