    "header": "<p data-path-to-node=\"4,0\"><strong data-path-to-node=\"4,0\" data-index-in-node=\"0\">IEEE Day 2026 | Yarmouk University</strong></p>\r\n<p data-path-to-node=\"4,1\"><strong data-path-to-node=\"4,1\" data-index-in-node=\"0\">Empowering Technology for Tomorrow</strong></p>\r\n<p data-path-to-node=\"4,2\"><em data-path-to-node=\"4,2\" data-index-in-node=\"0\">Hosted by Yarmouk University IEEE Student Branch</em></p>",
    "footer": "<p data-path-to-node=\"8,0\">&nbsp;Hijjawi Faculty for Engineering Technology, Yarmouk University &mdash; Irbid, Jordan</p>\r\n<p data-path-to-node=\"8,1\">&nbsp;October 17, 2026 | 09:00 AM &ndash; 03:00 PM</p>\r\n<p data-path-to-node=\"8,4\">&nbsp;</p>\r\n<p data-path-to-node=\"8,5\">&nbsp;</p>",
